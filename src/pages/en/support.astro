---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import SupportPage from '../../components/support/SupportPage.astro';
import { t } from '../../i18n';

export const prerender = true;

const loc = 'en';
const title = `${t(loc, 'support.title')} | ${t(loc, 'site.name')}`;
const description = t(loc, 'support.lead');
---

<BaseLayout title={title} description={description} seoPath="support">
	<SupportPage />
</BaseLayout>
