---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import ProductsPage from '../../../components/products/ProductsPage.astro';
import { t } from '../../../i18n';

export const prerender = true;

const loc = 'en';
const title = `${t(loc, 'products.index.title')} | ${t(loc, 'site.name')}`;
const description = t(loc, 'products.index.lead');
---

<BaseLayout title={title} description={description} seoPath="products">
	<ProductsPage loc={loc} />
</BaseLayout>
