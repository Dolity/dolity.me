---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AboutPage from '../../components/about/AboutPage.astro';
import { t } from '../../i18n';

export const prerender = true;

const loc = 'th';
const title = `${t(loc, 'about.title')} | ${t(loc, 'site.name')}`;
const description = t(loc, 'about.lead');
---

<BaseLayout title={title} description={description} seoPath="about">
	<AboutPage />
</BaseLayout>
