---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ResumeHeader from '../../components/resume/ResumeHeader.astro';
import ResumeBody from '../../components/resume/ResumeBody.astro';
import { t } from '../../i18n';

export const prerender = true;

const loc = 'th';
---

<BaseLayout
	title={`${t(loc, 'resume.title')} — ${t(loc, 'resume.name')}`}
	description={t(loc, 'resume.lead')}
	seoPath="resume"
	ogImage="/profile_dlt_dev.png"
>
	<div class="space-y-14">
		<ResumeHeader />
		<ResumeBody />
	</div>
</BaseLayout>
