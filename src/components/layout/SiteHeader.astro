---
/**
 * The terminal title bar.
 *
 * Not `transition:persist` — persisting would carry the *old* header into the
 * new page, so switching TH→EN would leave the header in the previous
 * language. It swaps like everything else; the brand mark keeps visual
 * continuity through a named transition instead.
 *
 * Active state is a `data-active` attribute, styled in CSS below. The client
 * script toggles the attribute and never touches class strings, so there is
 * only one definition of what "active" looks like.
 */
import {
	HEADER_SECTIONS,
	hrefForLocale,
	navSectionFromPathname,
	otherLocale,
	segmentFromPathname,
	t,
	toLocale,
} from '../../i18n';
import BrandLockup from './BrandLockup.astro';
import SiteContainer from './SiteContainer.astro';
import ThemeToggle from './ThemeToggle.astro';

const loc = toLocale(Astro.currentLocale);
const segment = segmentFromPathname(Astro.url.pathname);
const activeNav = navSectionFromPathname(Astro.url.pathname);
const next = otherLocale(loc);
---

<header
	class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur"
	data-print="hide"
	transition:name="site-header"
>
	<SiteContainer class="flex min-h-14 items-center gap-3">
		<div class="flex-1">
			<BrandLockup variant="header" />
		</div>

		<nav class="hidden items-center gap-1 sm:flex" aria-label={t(loc, 'palette.pages')}>
			{
				HEADER_SECTIONS.map((s) => (
					<a
						href={hrefForLocale(loc, s.segment)}
						class="site-nav-link"
						data-nav={s.id}
						data-ga-event="select_content"
						data-ga-params={JSON.stringify({
							content_type: 'nav',
							content_id: s.id,
							link_location: 'header',
						})}
						data-active={activeNav === s.id ? '' : undefined}
						aria-current={activeNav === s.id ? 'page' : undefined}
					>
						{t(loc, s.labelKey)}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-1.5">
			<button
				type="button"
				data-palette-open
				class="inline-flex items-center gap-1.5 rounded-md border border-line px-2 py-1.5 font-mono text-xs text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
				aria-label={t(loc, 'palette.open')}
			>
				<span data-kbd-ctrl aria-hidden="true">Ctrl K</span>
				<span data-kbd-mac aria-hidden="true">⌘K</span>
				<svg
					data-kbd-touch
					viewBox="0 0 24 24"
					width="14"
					height="14"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="7"></circle>
					<path d="M20 20l-4.7-4.7"></path>
				</svg>
			</button>

			<a
				href={hrefForLocale(next, segment)}
				class="rounded-md border border-line px-2 py-1.5 text-xs font-medium text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
				data-ga-event="language_switch"
				data-ga-params={JSON.stringify({ language: next })}
				aria-label={t(loc, 'nav.langSwitchAria')}
			>
				{t(loc, 'nav.langSwitch')}
			</a>

			<ThemeToggle />
		</div>
	</SiteContainer>
</header>

<style>
	.site-nav-link {
		border-radius: 0.375rem;
		padding: 0.375rem 0.625rem;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--muted);
		transition: color 150ms ease;
	}
	.site-nav-link:hover {
		color: var(--ink);
	}
	/* The single definition of "active". The client script only toggles the
	   attribute after a view transition; it never rewrites class names. */
	.site-nav-link[data-active] {
		color: var(--ink);
		font-weight: 500;
		box-shadow: inset 0 -2px 0 0 var(--accent);
	}

	/* Which palette hint shows is decided here alone. `data-kbd` is set on <html>
	   before first paint in BaseLayout and carried across view transitions, the
	   same way `data-theme` is; no JS touches the button. `Ctrl K` is the default
	   so the button is never empty when the attribute is missing (JS disabled). */
	[data-kbd-mac],
	[data-kbd-touch] {
		display: none;
	}
	:root[data-kbd='mac'] [data-kbd-ctrl],
	:root[data-kbd='touch'] [data-kbd-ctrl] {
		display: none;
	}
	:root[data-kbd='mac'] [data-kbd-mac] {
		display: inline;
	}
	:root[data-kbd='touch'] [data-kbd-touch] {
		display: block;
	}
</style>
