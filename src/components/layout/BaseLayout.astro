---
import { ClientRouter } from 'astro:transitions';
import SeoHead from './SeoHead.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import '../../styles/global.css';
import { THEME_STORAGE_KEY } from '../../constants/theme';

interface Props {
	title: string;
	description: string;
	seoPath?: string;
}

const { title, description, seoPath = '' } = Astro.props;
const lang = Astro.currentLocale === 'en' ? 'en' : 'th';
const GA_MEASUREMENT_ID = import.meta.env.GA_MEASUREMENT_ID ?? 'G-8J3CNGZ6TX';
---

<!doctype html>
<html lang={lang}>
	<head>
		<SeoHead title={title} description={description} seoPath={seoPath} />
		<ClientRouter />
		<script is:inline define:vars={{ THEME_STORAGE_KEY }}>
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem(THEME_STORAGE_KEY);
				} catch (_) {}
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const theme =
					stored === 'pastel' || stored === 'forest' ? stored : prefersDark ? 'forest' : 'pastel';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
		<script>
			import { THEME_STORAGE_KEY } from '../../constants/theme';
			import { initGaDelegatedClicks } from '../../lib/ga-delegated-clicks';

			initGaDelegatedClicks();

			function applyThemeFromUserPreference() {
				let stored = null;
				try {
					stored = localStorage.getItem(THEME_STORAGE_KEY);
				} catch {
					/* ignore */
				}
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const theme =
					stored === 'pastel' || stored === 'forest' ? stored : prefersDark ? 'forest' : 'pastel';
				document.documentElement.setAttribute('data-theme', theme);
			}

			function syncThemeToggleLabels() {
				const moon = document.getElementById('dolity-theme-label-moon');
				const sun = document.getElementById('dolity-theme-label-sun');
				if (!moon || !sun) return;
				const isDark = document.documentElement.getAttribute('data-theme') === 'forest';
				moon.classList.toggle('hidden', !isDark);
				sun.classList.toggle('hidden', isDark);
			}

			function onThemeToggleClick(ev: MouseEvent) {
				const el = ev.target;
				if (!(el instanceof Element)) return;
				const btn = el.closest('#dolity-theme-toggle');
				if (!btn) return;
				ev.preventDefault();
				const html = document.documentElement;
				const next = html.getAttribute('data-theme') === 'forest' ? 'pastel' : 'forest';
				html.setAttribute('data-theme', next);
				try {
					localStorage.setItem(THEME_STORAGE_KEY, next);
				} catch {
					/* ignore */
				}
				syncThemeToggleLabels();
			}

			document.addEventListener('click', onThemeToggleClick);
			document.addEventListener('astro:page-load', () => {
				applyThemeFromUserPreference();
				syncThemeToggleLabels();
			});
		</script>


    <!-- Google tag (gtag.js) -->
    <!-- ต้องใส่ is:inline เพื่อบอกให้ Astro ไม่ต้องนำ script นี้ไป Bundle -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    
    <!-- ใช้ define:vars เพื่อส่งค่าตัวแปรจากฝั่ง Server (Frontmatter) เข้าไปใน Client Script -->
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    </script>

	</head>
	<body class="font-sans flex min-h-screen flex-col bg-base-100 text-base-content">
		<SiteHeader />
		<main class="flex-1">
			<div class="container mx-auto px-4 py-10">
				<slot />
			</div>
		</main>
		<SiteFooter />
	</body>
</html>
