---
/** The favicon "D" completes the wordmark: mark + "olity" reads as "Dolity". */
import { Image } from 'astro:assets';
import { FAVICON_PNG_96, SITE_WORDMARK_SUFFIX } from '../../constants/site-assets';
import { hrefForLocale, t, toLocale } from '../../i18n';

interface Props {
	variant?: 'header' | 'footer';
}

const { variant = 'header' } = Astro.props;
const loc = toLocale(Astro.currentLocale);
---

<a
	href={hrefForLocale(loc, '')}
	class:list={['group brand-lockup', `brand-lockup--${variant}`]}
	data-ga-event="select_content"
	data-ga-params={JSON.stringify({
		content_type: 'nav',
		content_id: 'home',
		link_location: variant,
	})}
	aria-label={t(loc, 'site.name')}
>
	<span class="brand-mark">
		<Image src={FAVICON_PNG_96} alt="" width="40" height="40" priority aria-hidden="true" loading="eager"/>
	</span>
	<span class="brand-lockup__text">{SITE_WORDMARK_SUFFIX}</span>
</a>
