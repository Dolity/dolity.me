---
import { FAVICON_PNG_96, SITE_WORDMARK_SUFFIX } from '../../constants/site-assets';
import { hrefForLocale, t } from '../../i18n';

interface Props {
	variant?: 'header' | 'footer';
}

const { variant = 'header' } = Astro.props;
const raw = Astro.currentLocale ?? 'th';
const loc = raw === 'en' ? 'en' : 'th';
const h = (s: string) => hrefForLocale(loc, s);
const isHeader = variant === 'header';
---

<a
	href={h('')}
	class:list={['brand-lockup group', isHeader ? 'brand-lockup--header' : 'brand-lockup--footer']}
	aria-label={t(loc, 'site.name')}
>
	<span class="brand-pill">
		<span class="brand-pill__mark" aria-hidden="true">
			<img
				src={FAVICON_PNG_96}
				alt=""
				width="96"
				height="96"
				class="brand-pill__img"
				loading={isHeader ? 'eager' : 'lazy'}
				decoding="async"
			/>
		</span>
		<span class="brand-pill__text">{SITE_WORDMARK_SUFFIX}</span>
	</span>
</a>
