---
import { t } from '../../i18n/strings';

const locale = Astro.currentLocale ?? 'th';
const labelDark = t(locale, 'theme.dark');
const labelLight = t(locale, 'theme.light');
---

<button
	id="dolity-theme-toggle"
	type="button"
	class="btn btn-ghost btn-sm inline-flex h-9 min-h-9 w-9 min-w-9 shrink-0 items-center justify-center border-2 border-primary/35 bg-base-100/50 p-0 hover:border-primary/50 hover:bg-base-300/25"
	aria-label={labelDark}
>
	<svg id="dolity-theme-label-moon" class="hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"/>
	</svg>
	<svg id="dolity-theme-label-sun" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2" fill="none"/>
		<path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
	</svg>
</button>
