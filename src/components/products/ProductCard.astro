---
import type { Locale, ProductCatalogItem } from '../../data/products-catalog';
import { hrefForLocale, t } from '../../i18n';
import TechStackRow from './TechStackRow.astro';

interface Props {
	item: ProductCatalogItem;
	loc: Locale;
	variant: 'primary' | 'secondary';
}

const { item, loc, variant } = Astro.props;

const title = item.title[loc];
const summary = item.summary[loc];
const period = item.period[loc];
const badge = item.badge[loc];
const highlights = item.highlights[loc];
const prodUrl = item.prodUrl;
const detailHref = item.detailPath ? hrefForLocale(loc, item.detailPath) : null;

const sameSite = item.id === 'dolity';
const prodHref = prodUrl ?? '';

const isPrimary = variant === 'primary';
const articleClass = isPrimary
	? 'group relative flex flex-col overflow-hidden rounded-3xl border-2 border-primary/20 bg-base-200 p-6 shadow-lg transition duration-300 hover:border-primary/40 hover:shadow-xl lg:p-8'
	: 'group relative flex flex-col overflow-hidden rounded-3xl border border-base-300/80 bg-gradient-to-b from-base-200 to-base-300/40 p-6 shadow-md transition duration-300 hover:border-secondary/40 hover:shadow-xl lg:p-8';
---

<article
	id={`product-${item.id}`}
	class:list={[articleClass, 'scroll-mt-28']}
	aria-labelledby={`${item.id}-title`}
>
	{
		isPrimary ? (
			<div
				class="pointer-events-none absolute -right-16 top-0 h-48 w-48 rounded-full bg-primary/10 blur-2xl transition group-hover:bg-primary/15"
				aria-hidden="true"
			/>
		) : (
			<div
				class="pointer-events-none absolute -left-12 bottom-0 h-40 w-40 rounded-full bg-secondary/15 blur-2xl group-hover:bg-secondary/20"
				aria-hidden="true"
			/>
		)
	}

	<div class="relative flex flex-1 flex-col gap-6">
		<div class="flex flex-wrap items-center gap-2">
			<span class="badge badge-outline badge-sm font-normal opacity-95">{period}</span>
			<span class="badge badge-ghost badge-sm border border-base-300/60 font-normal">{badge}</span>
		</div>

		<div class="flex flex-1 flex-col gap-6 sm:flex-row sm:items-start">
			{
				item.logoSrc ? (
					<span
						class:list={[
							'flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl ring-1',
							isPrimary
								? 'bg-primary/15 ring-primary/25'
								: 'bg-secondary/20 ring-secondary/30',
						]}
						aria-hidden="true"
					>
						<img
							src={item.logoSrc}
							alt=""
							width="56"
							height="56"
							class="h-full w-full object-contain p-2"
							loading="lazy"
							decoding="async"
						/>
					</span>
				) : isPrimary ? (
					<span
						class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-primary/15 text-primary ring-1 ring-primary/25"
						aria-hidden="true"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-8 w-8"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="1.5"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.612l-4.88 4.88a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-5.05 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.88 4.88a4.5 4.5 0 0 0 1.242 7.612"
							/>
						</svg>
					</span>
				) : (
					<span
						class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-secondary/20 text-secondary ring-1 ring-secondary/30"
						aria-hidden="true"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-8 w-8"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="1.5"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
							/>
						</svg>
					</span>
				)
			}

			<div class="min-w-0 flex-1">
				<h3 id={`${item.id}-title`} class="text-2xl font-bold tracking-tight sm:text-3xl">
					{title}
				</h3>
				<p class="mt-3 max-w-prose leading-relaxed opacity-90">{summary}</p>
			</div>
		</div>

		<div>
			<h4 class="mb-2 text-sm font-bold uppercase tracking-wide text-primary opacity-95">
				{t(loc, 'products.catalog.highlightsHeading')}
			</h4>
			<ul class="list-inside list-disc space-y-1.5 text-sm leading-relaxed opacity-90 sm:text-base">
				{highlights.map((line) => (
					<li>{line}</li>
				))}
			</ul>
		</div>

		<div>
			<h4 class="mb-2 text-sm font-bold uppercase tracking-wide text-primary opacity-95">
				{t(loc, 'products.catalog.techHeading')}
			</h4>
			<TechStackRow items={item.tech} />
		</div>

		<div class="relative mt-2 flex flex-wrap gap-2 pt-2">
			{
				prodUrl ? (
					<a
						class="btn btn-primary btn-sm shadow-md"
						href={prodHref}
						{...(sameSite ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
						data-ga-event="products_open_website_click"
						data-ga-params={JSON.stringify({ locale: loc, project_id: item.id })}
					>
						{t(loc, 'products.catalog.openSite')}
						{sameSite ? null : <span class="ml-1 opacity-70">↗</span>}
					</a>
				) : null
			}
			{
				detailHref ? (
					<a class="btn btn-ghost btn-sm border border-base-300" href={detailHref}>
						{t(loc, 'products.catalog.detailPage')}
					</a>
				) : null
			}
		</div>
	</div>
</article>
