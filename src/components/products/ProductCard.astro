---
/**
 * One catalog entry, expanded. `id` stays the anchor target (`#product-<id>`)
 * because other pages link straight to it.
 */
import TechStackRow from './TechStackRow.astro';
import Button from '../ui/Button.astro';
import type { ProductCatalogItem } from '../../data/products-catalog';
import { hrefForLocale, t, type Locale } from '../../i18n';

interface Props {
	item: ProductCatalogItem;
	loc: Locale;
	headingLevel?: 2 | 3;
}

const { item, loc, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const host = item.prodUrl ? new URL(item.prodUrl).hostname : null;
---

<article
	id={`product-${item.id}`}
	class="scroll-mt-24 border-t border-line py-8"
	data-print="keep"
>
	<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
		<span class="font-mono text-sm text-accent" aria-hidden="true">▸</span>
		<Heading class="text-lg font-semibold tracking-tight text-ink">{item.title[loc]}</Heading>
		<span class="font-mono text-xs text-muted">{item.period[loc]}</span>
	</div>

	<p class="prose-measure mt-3 text-sm text-ink">{item.summary[loc]}</p>

	<div class="mt-5 grid gap-6 sm:grid-cols-2">
		<div>
			<h4 class="font-mono text-xs uppercase text-muted">{t(loc, 'products.highlights')}</h4>
			<ul class="mt-2 space-y-1.5">
				{
					item.highlights[loc].map((line) => (
						<li class="flex gap-2 text-sm leading-relaxed text-muted">
							<span class="font-mono text-accent" aria-hidden="true">
								–
							</span>
							<span>{line}</span>
						</li>
					))
				}
			</ul>
		</div>

		<div>
			<h4 class="font-mono text-xs uppercase text-muted">{t(loc, 'products.tech')}</h4>
			<div class="mt-2">
				<TechStackRow items={item.tech} />
			</div>
		</div>
	</div>

	<div class="mt-6 flex flex-wrap gap-2">
		{
			item.prodUrl && (
				<Button
					href={item.prodUrl}
					variant="primary"
					external
					gaEvent="select_content"
					gaParams={{
						content_type: 'product_site',
						content_id: item.slug,
						link_location: 'products_card',
					}}
				>
					{host ?? t(loc, 'products.openSite')}
				</Button>
			)
		}
		<Button
			href={hrefForLocale(loc, `products/${item.slug}`)}
			gaEvent="select_content"
			gaParams={{
				content_type: 'product_detail',
				content_id: item.slug,
				link_location: 'products_card',
			}}
		>
			{t(loc, 'products.detail')}
		</Button>
	</div>
</article>
