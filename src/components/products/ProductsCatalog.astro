---
import type { Locale } from '../../data/products-catalog';
import { getProductsSorted } from '../../data/products-catalog';
import { t } from '../../i18n';
import ProductCard from './ProductCard.astro';

interface Props {
	loc: Locale;
}

const { loc } = Astro.props;
const items = getProductsSorted();
---

<section class="py-2" aria-labelledby="catalog-heading">
	<div class="mb-10 max-w-3xl">
		<p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">
			{t(loc, 'products.catalog.sectionEyebrow')}
		</p>
		<h2 id="catalog-heading" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
			{t(loc, 'products.catalog.sectionHeading')}
		</h2>
		<p class="mt-4 text-lg leading-relaxed opacity-90">{t(loc, 'products.catalog.sectionLead')}</p>
	</div>

	<div class="flex flex-col gap-8 sm:gap-10">
		{items.map((item, i) => (
			<ProductCard
				item={item}
				loc={loc}
				variant={i % 2 === 0 ? 'primary' : 'secondary'}
			/>
		))}
	</div>
</section>
