---
/**
 * A tech name with its brand mark.
 *
 * The mark is inlined from `TECH_ICONS` at build time — no third-party request
 * and no client JS, which is why this doesn't go back to cdn.simpleicons.org.
 * Badges with no icon (Recharts, next-intl, cron…) keep the mono `·` bullet.
 * The mark is monochrome so it reads as part of the label in both themes.
 */
import { TECH_ICONS } from '../../data/tech-icons';
import type { TechIconSlug } from '../../data/tech-icons';

interface Props {
	label: string;
	slug?: TechIconSlug;
}

const { label, slug } = Astro.props;
const path = slug ? TECH_ICONS[slug] : undefined;
---

<span
	class="inline-flex items-center gap-1.5 rounded border border-line bg-surface-2 px-2 py-0.5 text-xs text-muted"
	title={label}
>
	{
		path ? (
			<svg
				viewBox="0 0 24 24"
				width="12"
				height="12"
				fill="currentColor"
				aria-hidden="true"
				class="shrink-0"
			>
				<path d={path} />
			</svg>
		) : (
			<span class="font-mono" aria-hidden="true">
				·
			</span>
		)
	}
	<span>{label}</span>
</span>
