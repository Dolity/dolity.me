---
/**
 * The only button on the site. `primary` is the single accented action per
 * view; everything else is `ghost`.
 */
interface Props {
	href: string;
	variant?: 'primary' | 'ghost';
	external?: boolean;
	gaEvent?: string;
	gaParams?: Record<string, string | number | boolean>;
	'aria-label'?: string;
	class?: string;
}

const {
	href,
	variant = 'ghost',
	external = false,
	gaEvent,
	gaParams,
	'aria-label': ariaLabel,
	class: className,
} = Astro.props;

const base =
	'inline-flex items-center gap-2 rounded-md border px-3.5 py-2 text-sm font-medium transition-colors duration-150';
const styles =
	variant === 'primary'
		? 'border-accent bg-accent text-accent-ink hover:opacity-90'
		: 'border-line bg-surface text-ink hover:border-accent hover:text-accent';
---

<a
	href={href}
	class:list={[base, styles, className]}
	aria-label={ariaLabel}
	data-ga-event={gaEvent}
	data-ga-params={gaParams ? JSON.stringify(gaParams) : undefined}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	data-print={external ? 'expand-link' : undefined}
>
	<slot />
	{external && <span class="font-mono text-xs opacity-70" aria-hidden="true">↗</span>}
</a>
