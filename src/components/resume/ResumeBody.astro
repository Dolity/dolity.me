---
import { getCollection, render } from 'astro:content';
import ResumeExpertise from './ResumeExpertise.astro';
import NextSteps from '../ui/NextSteps.astro';
import Prompt from '../ui/Prompt.astro';
import Row from '../ui/Row.astro';
import { getProductsSorted } from '../../data/products-catalog';
import { hrefForLocale, t, toLocale } from '../../i18n';

const loc = toLocale(Astro.currentLocale);

/** Locale is encoded in the entry id (`th/woxa`), so filter on the prefix. */
const forLocale = <T extends { id: string; data: { order: number } }>(entries: T[]) =>
	entries.filter((e) => e.id.startsWith(`${loc}/`)).sort((a, b) => a.data.order - b.data.order);

const experience = forLocale(await getCollection('experience'));
const education = forLocale(await getCollection('education'));
const certifications = forLocale(await getCollection('certifications'));
const products = getProductsSorted();

const rendered = await Promise.all(
	[...experience, ...education].map(async (entry) => ({
		id: entry.id,
		Content: (await render(entry)).Content,
	})),
);
const contentById = new Map(rendered.map((r) => [r.id, r.Content]));
---

<div class="space-y-14">
	<ResumeExpertise />

	<section data-ga-section="experience">
		<Prompt cmd={t(loc, 'cmd.experience')} heading={t(loc, 'resume.experience')} />
		<ol class="mt-5 border-t border-line">
			{
				experience.map((entry) => {
					const Content = contentById.get(entry.id)!;
					return (
						<li class="border-b border-line py-6" data-print="keep">
							<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
								<h3 class="font-semibold text-ink">{entry.data.title}</h3>
								<span class="font-mono text-xs text-muted">{entry.data.period}</span>
							</div>
							<p class="mt-1 text-sm text-muted">
								{entry.data.company}
								{entry.data.location && ` · ${entry.data.location}`}
							</p>
							<div class="resume-prose mt-3">
								<Content />
							</div>
						</li>
					);
				})
			}
		</ol>
	</section>

	<section data-ga-section="education">
		<Prompt cmd={t(loc, 'cmd.education')} heading={t(loc, 'resume.education')} />
		<ol class="mt-5 border-t border-line">
			{
				education.map((entry) => {
					const Content = contentById.get(entry.id)!;
					return (
						<li class="border-b border-line py-6" data-print="keep">
							<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
								<h3 class="font-semibold text-ink">{entry.data.institution}</h3>
								<span class="font-mono text-xs text-muted">{entry.data.period}</span>
							</div>
							<p class="mt-1 text-sm text-muted">
								{entry.data.degree}
								{entry.data.grade && ` · ${entry.data.grade}`}
							</p>
							<div class="resume-prose mt-3">
								<Content />
							</div>
						</li>
					);
				})
			}
		</ol>
	</section>

	<section data-ga-section="certifications">
		<Prompt cmd={t(loc, 'cmd.certs')} heading={t(loc, 'resume.certifications')} />
		<ul class="mt-5 border-t border-line">
			{
				certifications.map((entry) => (
					<li
						class="flex flex-col gap-1 border-b border-line py-4 sm:flex-row sm:items-baseline sm:gap-4"
						data-print="keep"
					>
						<span class="shrink-0 font-mono text-xs text-muted sm:w-24">{entry.data.issued}</span>
						<span class="min-w-0 flex-1">
							<span class="block text-sm font-medium text-ink">{entry.data.title}</span>
							<span class="block text-sm text-muted">{entry.data.issuer}</span>
							{entry.data.credentialId && (
								<span class="block font-mono text-xs text-muted">
									{t(loc, 'resume.credentialId')}: {entry.data.credentialId}
								</span>
							)}
						</span>
						{entry.data.credentialUrl && (
							<a
								href={entry.data.credentialUrl}
								target="_blank"
								rel="noopener noreferrer"
								data-ga-event="select_content"
								data-ga-params={JSON.stringify({
									content_type: 'certification',
									content_id: entry.id.slice(loc.length + 1),
									link_location: 'resume_certs',
								})}
								data-print="expand-link"
								class="shrink-0 font-mono text-xs text-accent hover:underline"
							>
								{t(loc, 'resume.verifyCredential')} ↗
							</a>
						)}
					</li>
				))
			}
		</ul>
	</section>

	<section data-ga-section="projects">
		<Prompt cmd={t(loc, 'cmd.projects')} heading={t(loc, 'resume.projects')}>
			<p class="prose-measure pt-1 text-sm text-muted">{t(loc, 'resume.projectsLead')}</p>
		</Prompt>
		<div class="mt-5 border-t border-line">
			{
				products.map((p) => (
					<Row
						href={p.prodUrl ?? hrefForLocale(loc, `products/${p.slug}`)}
						name={p.id}
						title={p.title[loc]}
						desc={p.summary[loc]}
						meta={p.prodUrl ? new URL(p.prodUrl).hostname : undefined}
						external={Boolean(p.prodUrl)}
						gaEvent="select_content"
						gaParams={{
							content_type: p.prodUrl ? 'product_site' : 'product_detail',
							content_id: p.slug,
							link_location: 'resume_projects',
						}}
					/>
				))
			}
		</div>
	</section>

	<NextSteps sections={['products', 'about', 'uses', 'support']} />
</div>

<style>
	/* Markdown bodies from the content collections. */
	.resume-prose :global(ul) {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}
	.resume-prose :global(li) {
		position: relative;
		padding-left: 1.25rem;
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--muted);
	}
	.resume-prose :global(li)::before {
		content: '\2013';
		position: absolute;
		left: 0;
		color: var(--accent);
		font-family: var(--font-mono);
	}
	.resume-prose :global(p) {
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--muted);
	}
	.resume-prose :global(strong) {
		font-weight: 500;
		color: var(--ink);
	}
</style>
