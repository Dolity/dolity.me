---
import { RESUME_GITHUB_URL, RESUME_LINKEDIN_URL } from '../../constants/social';
import { hrefForLocale, t } from '../../i18n';

const raw = Astro.currentLocale ?? 'th';
const loc = raw === 'en' ? 'en' : 'th';
const h = (s: string) => hrefForLocale(loc, s);
const resumeWithExpertiseAnchor = `${h('resume')}#expertise`;
---

<section
	class="relative isolate overflow-hidden rounded-3xl border border-base-300/70 bg-base-200/30 shadow-2xl shadow-base-300/40"
>
	<div
		class="pointer-events-none absolute inset-0 opacity-[0.2]"
		aria-hidden="true"
		style="background-image: linear-gradient(to right, oklch(0 0 0 / 0.06) 1px, transparent 1px), linear-gradient(to bottom, oklch(0 0 0 / 0.06) 1px, transparent 1px); background-size: 28px 28px;"
	>
	</div>
	<div
		class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-primary/25 blur-3xl"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute -bottom-28 -left-24 h-80 w-80 rounded-full bg-secondary/30 blur-3xl"
		aria-hidden="true"
	>
	</div>

	<div class="relative px-5 py-10 sm:px-10 sm:py-14 lg:px-14">
		<div class="flex flex-col items-center gap-8 sm:flex-row sm:items-start sm:gap-10">
			<img
				src="/profile_dlt_dev.png"
				alt={t(loc, 'resume.profilePhotoAlt')}
				class="h-32 w-32 shrink-0 rounded-3xl border-4 border-base-100 bg-base-100 object-cover shadow-xl ring-2 ring-primary/20 sm:h-40 sm:w-40"
				width="160"
				height="160"
				loading="eager"
				decoding="async"
			/>
			<div class="min-w-0 flex-1 text-center sm:text-left">
				<p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">
					{t(loc, 'resume.heroEyebrow')}
				</p>
				<h1
					class="mt-3 bg-gradient-to-br from-primary via-secondary to-primary bg-clip-text text-4xl font-bold tracking-tight text-transparent sm:text-5xl lg:text-6xl"
				>
					{t(loc, 'resume.displayName')}
				</h1>
				<p class="mt-4 text-lg font-semibold text-base-content/90 sm:text-xl">{t(loc, 'resume.headline')}</p>
				<p class="mt-4 text-lg leading-relaxed text-base-content/85 sm:text-xl">
					{t(loc, 'resume.summary')}
				</p>
				<div class="mt-8 flex flex-wrap justify-center gap-3 sm:justify-start">
					<a
						class="btn btn-primary px-6 shadow-lg shadow-primary/25"
						href={RESUME_LINKEDIN_URL}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={t(loc, 'resume.linkedinAria')}
					>
						{t(loc, 'resume.linkedinCta')}
						<span class="ml-1 opacity-80" aria-hidden="true">↗</span>
					</a>
					<a
						class="btn btn-outline btn-primary border-2"
						href={RESUME_GITHUB_URL}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={t(loc, 'resume.githubAria')}
					>
						{t(loc, 'resume.githubCta')}
						<span class="ml-1 opacity-80" aria-hidden="true">↗</span>
					</a>
					<a
						class="btn btn-ghost border border-base-300/80 bg-base-100/70"
						href={resumeWithExpertiseAnchor}
					>
						{t(loc, 'resume.expertiseLink')}
					</a>
				</div>
			</div>
		</div>
	</div>

	<div
		class="relative border-t border-base-300/60 bg-base-100/60 px-5 py-7 backdrop-blur-md sm:px-10 lg:px-14"
	>
		<p class="text-sm leading-relaxed text-base-content/80 sm:text-base lg:text-lg">
			{t(loc, 'resume.lead')}
		</p>
	</div>
</section>
