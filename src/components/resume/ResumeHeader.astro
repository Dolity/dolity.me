---
import Button from '../ui/Button.astro';
import Panel from '../ui/Panel.astro';
import Prompt from '../ui/Prompt.astro';
import { PROFILE_PHOTO_SRC } from '../../constants/site-assets';
import { CONTACT_EMAIL, RESUME_GITHUB_URL, RESUME_LINKEDIN_URL } from '../../constants/social';
import { t, toLocale } from '../../i18n';
import { Image } from 'astro:assets';

const loc = toLocale(Astro.currentLocale);
---

<Panel label={`dolity ~/${loc}/resume`}>
	<Prompt cmd={t(loc, 'cmd.summary')} level={1}>
		<div class="flex flex-col gap-6 pt-2 sm:flex-row sm:items-start">
			<Image
				src={PROFILE_PHOTO_SRC}
				alt={t(loc, 'resume.photoAlt')}
				width="96"
				height="96"
				priority
				class="size-20 shrink-0 rounded-md border border-line object-cover sm:size-24"
				loading="eager"
			/>

			<div class="min-w-0 space-y-2">
				<h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
					{t(loc, 'resume.name')}
				</h1>
				<p class="font-mono text-sm text-muted">
					{t(loc, 'resume.headline')} · {t(loc, 'resume.location')}
				</p>
				<p class="prose-measure text-sm text-ink">{t(loc, 'resume.summary')}</p>
				<p class="prose-measure text-sm text-muted">{t(loc, 'resume.summaryExtra')}</p>
			</div>
		</div>

		<div class="flex flex-wrap gap-2 pt-6" data-print="hide">
			<Button
				href={RESUME_LINKEDIN_URL}
				external
				gaEvent="select_content"
				gaParams={{
					content_type: 'social_profile',
					content_id: 'linkedin',
					link_location: 'resume_header',
				}}
				aria-label={t(loc, 'resume.linkedinAria')}
			>
				{t(loc, 'resume.linkedinCta')}
			</Button>
			<Button
				href={RESUME_GITHUB_URL}
				external
				gaEvent="select_content"
				gaParams={{
					content_type: 'social_profile',
					content_id: 'github',
					link_location: 'resume_header',
				}}
				aria-label={t(loc, 'resume.githubAria')}
			>
				{t(loc, 'resume.githubCta')}
			</Button>
			<Button
				href={`mailto:${CONTACT_EMAIL}`}
				gaEvent="generate_lead"
				gaParams={{ method: 'email', link_location: 'resume_header' }}
				aria-label={t(loc, 'resume.emailAria')}
			>
				{t(loc, 'resume.emailCta')}
			</Button>
			<button
				type="button"
				data-print-resume
				data-ga-event="resume_print"
				class="inline-flex items-center gap-2 rounded-md border border-accent bg-accent px-3.5 py-2 text-sm font-medium text-accent-ink transition-opacity duration-150 hover:opacity-90"
				aria-label={t(loc, 'resume.printAria')}
			>
				{t(loc, 'resume.print')}
			</button>
		</div>

		{/* Links are stripped of their href on paper, so print them out longhand. */}
		<p class="hidden font-mono text-xs text-muted print:block">
			{CONTACT_EMAIL} · {RESUME_LINKEDIN_URL} · {RESUME_GITHUB_URL}
		</p>
	</Prompt>
</Panel>

<script>
	document.addEventListener('click', (ev) => {
		const target = ev.target;
		if (target instanceof Element && target.closest('[data-print-resume]')) window.print();
	});
</script>
