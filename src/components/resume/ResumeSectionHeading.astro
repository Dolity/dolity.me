---
interface Props {
	eyebrow: string;
	title: string;
	id?: string;
}

const { eyebrow, title, id } = Astro.props;
---

<div class="mb-8 w-full">
	<p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">{eyebrow}</p>
	<h2 id={id} class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
</div>
