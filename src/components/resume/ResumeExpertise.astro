---
import TechStackRow from '../products/TechStackRow.astro';
import Prompt from '../ui/Prompt.astro';
import { getResumeExpertiseSections } from '../../data/resume-tech-stack';
import { t, toLocale } from '../../i18n';

const loc = toLocale(Astro.currentLocale);
const sections = getResumeExpertiseSections();
---

<section id="stack" class="scroll-mt-24" data-print="keep" data-ga-section="stack">
	<Prompt cmd={t(loc, 'cmd.stack')} heading={t(loc, 'resume.stack')} />

	<dl class="mt-5 border-t border-line">
		{
			sections.map((section) => (
				<div class="grid gap-2 border-b border-line py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
					<dt class="font-mono text-sm text-ink">{section.heading[loc]}</dt>
					<dd class="space-y-2">
						<TechStackRow items={section.tech} />
						{section.notes && <p class="text-xs text-muted">{section.notes[loc]}</p>}
					</dd>
				</div>
			))
		}
	</dl>
</section>
