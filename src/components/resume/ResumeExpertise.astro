---
import TechStackRow from '../products/TechStackRow.astro';
import {
	getResumeExpertiseSections,
	resumeExpertiseTitle,
	type Locale,
} from '../../data/resume-tech-stack';
import { t } from '../../i18n';

const loc = (Astro.currentLocale === 'en' ? 'en' : 'th') as Locale;

const title = resumeExpertiseTitle[loc];
const sections = getResumeExpertiseSections();
---

<section
	id="expertise"
	aria-labelledby="expertise-heading"
	class="relative isolate scroll-mt-28 overflow-hidden rounded-3xl border-2 border-primary/20 bg-base-200/40 shadow-lg transition duration-300 hover:border-primary/35 hover:shadow-xl"
>
	<div
		class="pointer-events-none absolute -right-16 top-0 h-56 w-56 rounded-full bg-primary/12 blur-3xl"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute -bottom-20 -left-12 h-64 w-64 rounded-full bg-secondary/20 blur-3xl"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute inset-0 opacity-[0.12]"
		aria-hidden="true"
		style="background-image: linear-gradient(to right, oklch(0 0 0 / 0.06) 1px, transparent 1px), linear-gradient(to bottom, oklch(0 0 0 / 0.06) 1px, transparent 1px); background-size: 28px 28px;"
	>
	</div>

	<div class="relative p-6 sm:p-8 lg:p-10">
		<p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">{t(loc, 'resume.expertiseEyebrow')}</p>
		<h2 id="expertise-heading" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
			{title}
		</h2>
		<div class="mt-10 space-y-8">
			{
				sections.map((section) => (
					<div
						id={`expertise-${section.id}`}
						class="rounded-2xl border border-base-300/70 bg-base-100/45 p-5 backdrop-blur-sm sm:p-6"
					>
						<h3 class="mb-3 flex items-center gap-3 border-b border-base-300/80 pb-2 text-lg font-bold text-base-content">
							<span
								class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary/15 text-primary ring-1 ring-primary/25"
								aria-hidden="true"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-5 w-5"
									fill="none"
									viewBox="0 0 24 24"
									stroke-width="1.5"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"
									/>
								</svg>
							</span>
							<span>{section.heading[loc]}</span>
						</h3>
						{section.notes ? (
							<p class="mb-3 text-sm leading-relaxed text-base-content/85">{section.notes[loc]}</p>
						) : null}
						<TechStackRow items={section.tech} />
					</div>
				))
			}
		</div>
	</div>
</section>
