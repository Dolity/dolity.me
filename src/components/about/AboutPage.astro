---
import NextSteps from '../ui/NextSteps.astro';
import Panel from '../ui/Panel.astro';
import Prompt from '../ui/Prompt.astro';
import { t, toLocale } from '../../i18n';

const loc = toLocale(Astro.currentLocale);
const paragraphs = [
	t(loc, 'about.p1'),
	t(loc, 'about.p2'),
	t(loc, 'about.p3'),
	t(loc, 'about.p4'),
];
---

<div class="space-y-12">
	<Panel label={`dolity ~/${loc}/about`}>
		<Prompt cmd={t(loc, 'cmd.about')} heading={t(loc, 'about.title')} level={1}>
			<div class="prose-measure space-y-4 pt-3 text-ink">
				{paragraphs.map((p) => <p>{p}</p>)}
			</div>
		</Prompt>
	</Panel>

	<NextSteps sections={['resume', 'products', 'uses', 'support']} />
</div>
