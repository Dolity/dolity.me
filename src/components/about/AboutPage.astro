---
import { hrefForLocale, t } from '../../i18n';

const raw = Astro.currentLocale ?? 'th';
const loc = raw === 'en' ? 'en' : 'th';
const h = (s: string) => hrefForLocale(loc, s);
---

<div class="space-y-12 pb-6 lg:space-y-16">
	<section class="relative isolate overflow-hidden rounded-3xl border border-base-300/70 bg-base-200/30 shadow-2xl shadow-base-300/40">
		<div
			class="pointer-events-none absolute inset-0 opacity-[0.2]"
			aria-hidden="true"
			style="background-image: linear-gradient(to right, oklch(0 0 0 / 0.06) 1px, transparent 1px), linear-gradient(to bottom, oklch(0 0 0 / 0.06) 1px, transparent 1px); background-size: 28px 28px;"
		>
		</div>
		<div
			class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-primary/25 blur-3xl"
			aria-hidden="true"
		>
		</div>
		<div
			class="pointer-events-none absolute -bottom-28 -left-24 h-80 w-80 rounded-full bg-secondary/30 blur-3xl"
			aria-hidden="true"
		>
		</div>

		<div class="relative px-5 py-12 sm:px-10 sm:py-16 lg:px-14">
			<p class="mb-5 text-xs font-bold uppercase tracking-[0.2em] text-primary sm:text-sm">
				{t(loc, 'about.pageEyebrow')}
			</p>
			<h1 class="max-w-4xl font-bold tracking-tight">
				<span class="block text-xl font-semibold text-base-content/80 sm:text-2xl">
					{t(loc, 'about.heroPrefix')}
				</span>
				<span
					class="mt-2 block bg-gradient-to-br from-primary via-secondary to-primary bg-clip-text text-4xl text-transparent sm:text-5xl lg:text-6xl"
				>
					{t(loc, 'about.heroBrand')}
				</span>
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-base-content/85 sm:text-xl">
				{t(loc, 'about.lead')}
			</p>
		</div>

		<div
			class="relative border-t border-base-300/60 bg-base-100/60 px-5 py-8 backdrop-blur-md sm:px-10 lg:px-14"
		>
			<p class="mx-auto max-w-3xl text-lg leading-relaxed text-base-content/85 sm:text-xl">
				{t(loc, 'about.intro')}
			</p>
		</div>
	</section>

	<section class="py-2" aria-labelledby="about-sections-heading">
		<div class="mb-10 max-w-3xl">
			<p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">
				{t(loc, 'about.sectionsEyebrow')}
			</p>
			<h2 id="about-sections-heading" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
				{t(loc, 'about.sectionsHeading')}
			</h2>
		</div>

		<div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
			<article
				class="group relative flex flex-col overflow-hidden rounded-3xl border-2 border-primary/20 bg-base-200 p-6 shadow-lg transition duration-300 hover:border-primary/40 hover:shadow-xl lg:col-span-7 lg:min-h-[17rem] lg:p-8"
			>
				<div
					class="pointer-events-none absolute -right-16 top-0 h-48 w-48 rounded-full bg-primary/10 blur-2xl transition group-hover:bg-primary/15"
					aria-hidden="true"
				>
				</div>
				<div class="relative flex flex-1 flex-col gap-6 sm:flex-row sm:items-start">
					<span
						class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-primary/15 text-primary ring-1 ring-primary/25"
						aria-hidden="true"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-8 w-8"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="1.5"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.282 48.282 0 0 0 5.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"
							>
							</path>
						</svg>
					</span>
					<div class="min-w-0 flex-1">
						<h3 class="text-2xl font-bold">{t(loc, 'about.secHubTitle')}</h3>
						<p class="mt-3 max-w-prose leading-relaxed opacity-90">{t(loc, 'about.hub')}</p>
					</div>
				</div>
			</article>

			<article
				class="group relative flex flex-col overflow-hidden rounded-3xl border border-base-300/80 bg-gradient-to-b from-base-200 to-base-300/40 p-6 shadow-md transition duration-300 hover:border-secondary/40 hover:shadow-xl lg:col-span-5 lg:min-h-[17rem] lg:p-8"
			>
				<div
					class="pointer-events-none absolute -left-12 bottom-0 h-40 w-40 rounded-full bg-secondary/15 blur-2xl group-hover:bg-secondary/20"
					aria-hidden="true"
				>
				</div>
				<div class="relative flex flex-1 flex-col gap-6 sm:flex-row sm:items-start">
					<span
						class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-secondary/20 text-secondary ring-1 ring-secondary/30"
						aria-hidden="true"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-8 w-8"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="1.5"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M3.75 13.5 10.5 6.75l4.5 4.5L20.25 4.5M3.75 13.5v6.75A2.25 2.25 0 0 0 6 22.5h12a2.25 2.25 0 0 0 2.25-2.25V13.5"
							>
							</path>
						</svg>
					</span>
					<div class="min-w-0 flex-1">
						<h3 class="text-2xl font-bold">{t(loc, 'about.secGoalsTitle')}</h3>
						<p class="mt-3 max-w-prose leading-relaxed opacity-90">{t(loc, 'about.goals')}</p>
					</div>
				</div>
			</article>

			<article
				class="group relative flex flex-col overflow-hidden rounded-3xl border border-accent/30 bg-base-200/80 p-6 shadow-md transition duration-300 hover:border-accent/50 hover:shadow-xl lg:col-span-12 lg:p-8"
			>
				<div
					class="pointer-events-none absolute -right-10 top-1/2 h-56 w-56 -translate-y-1/2 rounded-full bg-accent/15 blur-3xl group-hover:bg-accent/20"
					aria-hidden="true"
				>
				</div>
				<div class="relative flex flex-1 flex-col gap-6 lg:flex-row lg:items-start">
					<span
						class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-accent/20 text-accent-content ring-1 ring-accent/35"
						aria-hidden="true"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-8 w-8"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="1.5"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
							>
							</path>
						</svg>
					</span>
					<div class="min-w-0 flex-1">
						<h3 class="text-2xl font-bold">{t(loc, 'about.secHeartTitle')}</h3>
						<p class="mt-3 max-w-prose text-lg leading-relaxed opacity-90">{t(loc, 'about.heart')}</p>
					</div>
				</div>
			</article>
		</div>

		<div
			class="relative mt-14 overflow-hidden rounded-3xl border border-base-300/60 bg-gradient-to-br from-primary via-primary/90 to-secondary text-primary-content shadow-xl"
		>
			<div
				class="pointer-events-none absolute inset-0 opacity-25"
				aria-hidden="true"
				style="background-image: radial-gradient(circle at 20% 20%, white 0, transparent 50%), radial-gradient(circle at 80% 80%, white 0, transparent 45%);"
			>
			</div>
			<div class="relative flex flex-col gap-6 px-6 py-10 sm:px-10 lg:flex-row lg:items-center lg:justify-between">
				<div class="max-w-xl">
					<p class="text-xl font-bold leading-snug sm:text-2xl">{t(loc, 'about.ctaBand.title')}</p>
					<p class="mt-3 text-sm leading-relaxed opacity-90 sm:text-base">{t(loc, 'about.ctaBand.sub')}</p>
				</div>
				<nav
					class="flex shrink-0 flex-col gap-3 sm:flex-row sm:flex-wrap"
					aria-label={t(loc, 'about.ctaNavLabel')}
				>
					<a class="btn border-0 bg-base-100 text-base-content hover:bg-base-200" href={h('')}>
						{t(loc, 'nav.home')}
					</a>
					<a
						class="btn btn-outline border-2 border-primary-content/50 text-primary-content hover:border-primary-content hover:bg-primary-content/10"
						href={h('products')}
					>
						{t(loc, 'nav.products')}
					</a>
					<a
						class="btn btn-outline border-2 border-primary-content/50 text-primary-content hover:border-primary-content hover:bg-primary-content/10"
						href={h('resume')}
					>
						{t(loc, 'nav.resume')}
					</a>
					<a
						class="btn btn-outline border-2 border-primary-content/50 text-primary-content hover:border-primary-content hover:bg-primary-content/10"
						href={h('support')}
					>
						{t(loc, 'nav.support')}
					</a>
				</nav>
			</div>
		</div>
	</section>
</div>
