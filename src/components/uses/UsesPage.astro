---
import TechStackRow from '../products/TechStackRow.astro';
import NextSteps from '../ui/NextSteps.astro';
import Panel from '../ui/Panel.astro';
import Prompt from '../ui/Prompt.astro';
import { getResumeExpertiseSections } from '../../data/resume-tech-stack';
import { workbench } from '../../data/workbench';
import { t, toLocale } from '../../i18n';

const loc = toLocale(Astro.currentLocale);
const stack = getResumeExpertiseSections();
---

<div class="space-y-12">
	<Panel label={`dolity ~/${loc}/uses`}>
		<Prompt cmd={t(loc, 'cmd.uses')} heading={t(loc, 'uses.heading')} level={1}>
			<p class="prose-measure pt-2 text-ink">{t(loc, 'uses.lead')}</p>
			<p class="prose-measure pt-2 text-sm text-muted">{t(loc, 'uses.sectionLead')}</p>
		</Prompt>
	</Panel>

	{
		workbench.map((group) => (
			<section>
				<h2 class="font-mono text-xs uppercase text-muted">{group.heading[loc]}</h2>
				<ul class="mt-3 border-t border-line">
					{group.items.map((item) => (
						<li class="flex flex-col gap-1 border-b border-line px-2 py-4 sm:flex-row sm:gap-4">
							<span class="shrink-0 font-mono text-sm text-ink sm:w-48">
								{item.url ? (
									<a
										href={item.url}
										target="_blank"
										rel="noopener noreferrer"
										class="transition-colors duration-150 hover:text-accent"
									>
										{item.name}
										<span aria-hidden="true"> ↗</span>
									</a>
								) : (
									item.name
								)}
							</span>
							<span class="flex-1 text-sm leading-relaxed text-muted">{item.note[loc]}</span>
						</li>
					))}
				</ul>
			</section>
		))
	}

	<section>
		<h2 class="font-mono text-xs uppercase text-muted">{t(loc, 'uses.stackHeading')}</h2>
		<dl class="mt-3 border-t border-line">
			{
				stack.map((section) => (
					<div class="grid gap-2 border-b border-line py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
						<dt class="font-mono text-sm text-ink">{section.heading[loc]}</dt>
						<dd>
							<TechStackRow items={section.tech} />
						</dd>
					</div>
				))
			}
		</dl>
	</section>

	<NextSteps sections={['resume', 'products', 'now', 'support']} />
</div>
