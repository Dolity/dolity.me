---
import {
	FAVICON_PNG_96,
	HANBO_LOGO_SRC,
	PHIBOON_TOUR_LOGO_SRC,
	YORBO_LOGO_SRC,
} from '../../constants/site-assets';
import { hrefForLocale, t } from '../../i18n';

const raw = Astro.currentLocale ?? 'th';
const loc = raw === 'en' ? 'en' : 'th';
const h = (s: string) => hrefForLocale(loc, s);
---

<section class="py-12" aria-labelledby="products-heading">
	<div class="mb-10 max-w-3xl">
		<p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">
			{t(loc, 'home.products.eyebrow')}
		</p>
		<h2 id="products-heading" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
			{t(loc, 'home.products.heading')}
		</h2>
		<p class="mt-4 text-lg leading-relaxed opacity-90">{t(loc, 'home.products.lead')}</p>
	</div>

	<div class="grid gap-6 md:grid-cols-2 lg:gap-8">
		<article
			class="group relative flex flex-col overflow-hidden rounded-3xl border-2 border-primary/20 bg-base-200 p-6 shadow-lg transition duration-300 hover:border-primary/40 hover:shadow-xl lg:min-h-[17rem] lg:p-8"
		>
			<div
				class="pointer-events-none absolute -right-16 top-0 h-48 w-48 rounded-full bg-primary/10 blur-2xl transition group-hover:bg-primary/15"
				aria-hidden="true"
			>
			</div>
			<div class="relative flex flex-1 flex-col gap-6 sm:flex-row sm:items-start">
				<span
					class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-primary/15 ring-1 ring-primary/25"
					aria-hidden="true"
				>
					<img
						src={YORBO_LOGO_SRC}
						alt=""
						width="56"
						height="56"
						class="h-full w-full object-contain p-2"
						loading="eager"
						decoding="async"
					/>
				</span>
				<div class="min-w-0 flex-1">
					<h3 class="text-2xl font-bold">{t(loc, 'card.shorturl.title')}</h3>
					<p class="mt-3 max-w-prose leading-relaxed opacity-90">{t(loc, 'card.shorturl.desc')}</p>
				</div>
			</div>
			<div class="relative mt-8 flex flex-wrap gap-2">
				<a class="btn btn-ghost btn-sm border border-base-300" href={h('products/url-shortener')}>
					{t(loc, 'home.products.cardLearn')}
				</a>
				<a
					class="btn btn-primary btn-sm shadow-md"
					href="https://shorturl.dolity.me/"
					rel="noopener noreferrer"
					target="_blank"
				>
					{t(loc, 'card.shorturl.cta')}
				</a>
			</div>
		</article>

		<article
			class="group relative flex flex-col overflow-hidden rounded-3xl border border-base-300/80 bg-gradient-to-b from-base-200 to-base-300/40 p-6 shadow-md transition duration-300 hover:border-secondary/40 hover:shadow-xl lg:min-h-[17rem] lg:p-8"
		>
			<div
				class="pointer-events-none absolute -left-12 bottom-0 h-40 w-40 rounded-full bg-secondary/15 blur-2xl group-hover:bg-secondary/20"
				aria-hidden="true"
			>
			</div>
			<div class="relative flex flex-1 flex-col gap-6 sm:flex-row sm:items-start">
				<span
					class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-secondary/20 ring-1 ring-secondary/30"
					aria-hidden="true"
				>
					<img
						src={HANBO_LOGO_SRC}
						alt=""
						width="56"
						height="56"
						class="h-full w-full object-contain p-2"
						loading="lazy"
						decoding="async"
					/>
				</span>
				<div class="min-w-0 flex-1">
					<h3 class="text-2xl font-bold">{t(loc, 'card.bill.title')}</h3>
					<p class="mt-3 max-w-prose leading-relaxed opacity-90">{t(loc, 'card.bill.desc')}</p>
				</div>
			</div>
			<div class="relative mt-8 flex flex-wrap gap-2">
				<a class="btn btn-ghost btn-sm border border-base-300" href={h('products/billing')}>
					{t(loc, 'home.products.cardLearn')}
				</a>
				<a
					class="btn btn-primary btn-sm shadow-md"
					href="https://bill.dolity.me/"
					rel="noopener noreferrer"
					target="_blank"
				>
					{t(loc, 'card.bill.cta')}
				</a>
			</div>
		</article>

		<article
			class="group relative flex flex-col overflow-hidden rounded-3xl border border-base-300/80 bg-gradient-to-b from-base-200 to-base-300/40 p-6 shadow-md transition duration-300 hover:border-secondary/40 hover:shadow-xl lg:min-h-[17rem] lg:p-8"
		>
			<div
				class="pointer-events-none absolute -left-12 bottom-0 h-40 w-40 rounded-full bg-secondary/15 blur-2xl group-hover:bg-secondary/20"
				aria-hidden="true"
			>
			</div>
			<div class="relative flex flex-1 flex-col gap-6 sm:flex-row sm:items-start">
				<span
					class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-secondary/20 ring-1 ring-secondary/30"
					aria-hidden="true"
				>
					<img
						src={PHIBOON_TOUR_LOGO_SRC}
						alt=""
						width="56"
						height="56"
						class="h-full w-full object-contain p-2"
						loading="lazy"
						decoding="async"
					/>
				</span>
				<div class="min-w-0 flex-1">
					<h3 class="text-2xl font-bold">{t(loc, 'card.phiboon.title')}</h3>
					<p class="mt-3 max-w-prose leading-relaxed opacity-90">{t(loc, 'card.phiboon.desc')}</p>
				</div>
			</div>
			<div class="relative mt-8 flex flex-wrap gap-2">
				<a class="btn btn-ghost btn-sm border border-base-300" href={`${h('products')}#product-phiboontour`}>
					{t(loc, 'home.products.cardLearn')}
				</a>
				<a
					class="btn btn-primary btn-sm shadow-md"
					href="https://phiboontour.com/"
					rel="noopener noreferrer"
					target="_blank"
				>
					{t(loc, 'card.phiboon.cta')}
					<span class="ml-1 opacity-70">↗</span>
				</a>
			</div>
		</article>

		<article
			class="group relative flex flex-col overflow-hidden rounded-3xl border-2 border-primary/20 bg-base-200 p-6 shadow-lg transition duration-300 hover:border-primary/40 hover:shadow-xl lg:min-h-[17rem] lg:p-8"
		>
			<div
				class="pointer-events-none absolute -right-16 top-0 h-48 w-48 rounded-full bg-primary/10 blur-2xl transition group-hover:bg-primary/15"
				aria-hidden="true"
			>
			</div>
			<div class="relative flex flex-1 flex-col gap-6 sm:flex-row sm:items-start">
				<span
					class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-primary/15 ring-1 ring-primary/25"
					aria-hidden="true"
				>
					<img
						src={FAVICON_PNG_96}
						alt=""
						width="56"
						height="56"
						class="h-full w-full object-contain p-2"
						loading="lazy"
						decoding="async"
					/>
				</span>
				<div class="min-w-0 flex-1">
					<h3 class="text-2xl font-bold">{t(loc, 'card.dolity.title')}</h3>
					<p class="mt-3 max-w-prose leading-relaxed opacity-90">{t(loc, 'card.dolity.desc')}</p>
				</div>
			</div>
			<div class="relative mt-8 flex flex-wrap gap-2">
				<a class="btn btn-ghost btn-sm border border-base-300" href={`${h('products')}#product-dolity`}>
					{t(loc, 'home.products.cardLearn')}
				</a>
				<a class="btn btn-primary btn-sm shadow-md" href={h('')}>
					{t(loc, 'card.dolity.cta')}
				</a>
			</div>
		</article>
	</div>

	<div
		class="relative mt-14 overflow-hidden rounded-3xl border border-base-300/60 bg-gradient-to-br from-primary via-primary/90 to-secondary text-primary-content shadow-xl"
	>
		<div
			class="pointer-events-none absolute inset-0 opacity-25"
			aria-hidden="true"
			style="background-image: radial-gradient(circle at 20% 20%, white 0, transparent 50%), radial-gradient(circle at 80% 80%, white 0, transparent 45%);"
		>
		</div>
		<div class="relative flex flex-col gap-6 px-6 py-10 sm:px-10 lg:flex-row lg:items-center lg:justify-between">
			<div class="max-w-xl">
				<p class="text-xl font-bold leading-snug sm:text-2xl">{t(loc, 'home.ctaBand.title')}</p>
				<p class="mt-3 text-sm leading-relaxed opacity-90 sm:text-base">{t(loc, 'home.ctaBand.sub')}</p>
			</div>
			<div class="flex shrink-0 flex-col gap-3 sm:flex-row">
				<a
					class="btn border-0 bg-base-100 text-base-content hover:bg-base-200"
					href={h('about')}
				>
					{t(loc, 'home.ctaBand.about')}
				</a>
				<a
					class="btn btn-outline border-2 border-primary-content/50 text-primary-content hover:border-primary-content hover:bg-primary-content/10"
					href={h('support')}
				>
					{t(loc, 'home.ctaBand.support')}
				</a>
			</div>
		</div>
	</div>
</section>
