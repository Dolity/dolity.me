---
/**
 * The one orchestrated moment on the site: the session states itself once, on
 * load. `.boot` staggers its children by `--i`; the whole thing is CSS, runs
 * once, and is switched off entirely under prefers-reduced-motion.
 */
import Button from '../ui/Button.astro';
import Panel from '../ui/Panel.astro';
import { hrefForLocale, t, toLocale } from '../../i18n';

const loc = toLocale(Astro.currentLocale);
const h = (s: string) => hrefForLocale(loc, s);
---

<Panel label={`dolity ~/${loc}`}>
	<div class="boot space-y-4">
		<p class="prompt-line text-muted" style="--i: 0">{t(loc, 'cmd.whoami')}</p>

		<div class="space-y-1" style="--i: 1">
			<h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-4xl">
				{t(loc, 'home.name')}
			</h1>
			<p class="font-mono text-sm text-muted">{t(loc, 'home.role')}</p>
		</div>

		<p class="caret prose-measure text-lg text-ink sm:text-xl" style="--i: 2">
			{t(loc, 'home.pitch')}
		</p>

		<p class="prose-measure text-sm text-muted" style="--i: 3">{t(loc, 'home.lead')}</p>

		<div class="flex flex-wrap gap-2 pt-1" style="--i: 4">
			<Button href={h('resume')} variant="primary">{t(loc, 'home.ctaResume')}</Button>
			<Button href={h('products')}>{t(loc, 'home.ctaProducts')}</Button>
		</div>
	</div>
</Panel>
