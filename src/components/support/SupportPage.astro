---
import Button from '../ui/Button.astro';
import NextSteps from '../ui/NextSteps.astro';
import Panel from '../ui/Panel.astro';
import Prompt from '../ui/Prompt.astro';
import { SUPPORT_QR_SRC } from '../../constants/site-assets';
import { BUY_ME_A_COFFEE_URL, CONTACT_EMAIL } from '../../constants/social';
import { t, toLocale } from '../../i18n';

const loc = toLocale(Astro.currentLocale);
const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(t(loc, 'support.email.subject'))}`;
---

<div class="space-y-12">
	<Panel label={`dolity ~/${loc}/support`}>
		<Prompt cmd={t(loc, 'cmd.support')} heading={t(loc, 'support.title')} level={1}>
			<p class="prose-measure pt-2 text-ink">{t(loc, 'support.lead')}</p>
			<p class="prose-measure pt-2 text-sm text-muted">{t(loc, 'support.sectionLead')}</p>
		</Prompt>
	</Panel>

	<div class="grid gap-6 sm:grid-cols-2">
		<section class="rounded-lg border border-line bg-surface p-6">
			<h2 class="font-semibold text-ink">{t(loc, 'support.bmc.title')}</h2>
			<p class="mt-2 text-sm leading-relaxed text-muted">{t(loc, 'support.bmc.desc')}</p>
			<div class="mt-5">
				<Button href={BUY_ME_A_COFFEE_URL} variant="primary" external>
					{t(loc, 'support.bmc.cta')}
				</Button>
			</div>
			<figure class="mt-6">
				<figcaption class="font-mono text-xs text-muted">{t(loc, 'support.bmc.scan')}</figcaption>
				<img
					src={SUPPORT_QR_SRC}
					alt={t(loc, 'support.bmc.imgAlt')}
					width="160"
					height="160"
					loading="eager"
					decoding="sync"
					fetchpriority="high"
					class="mt-2 size-40 rounded-md border border-line bg-white p-2"
				/>
			</figure>
		</section>

		<section class="rounded-lg border border-line bg-surface p-6">
			<h2 class="font-semibold text-ink">{t(loc, 'support.email.title')}</h2>
			<p class="mt-2 text-sm leading-relaxed text-muted">{t(loc, 'support.email.desc')}</p>
			<p class="mt-4 font-mono text-sm text-ink">{CONTACT_EMAIL}</p>
			<div class="mt-5">
				<Button href={mailto}>{t(loc, 'support.email.cta')}</Button>
			</div>
		</section>
	</div>

	<NextSteps sections={['home', 'products', 'resume', 'about']} />
</div>
